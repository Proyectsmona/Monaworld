{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monaworld",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OVERLAY_ROOM",
        "class_name": "OverlayRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OverlayRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monaworld",
      "database_id": "b6adc942-87de-4331-b747-6e6483b72f12"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://monaworld.lamonachinajuega.workers.dev/",
    "UC_PER_UNIT": "100"
  }
}
