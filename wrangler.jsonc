{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monaworld",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/room/*", "/webhooks/*", "/media/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "OVERLAY_ROOM", "class_name": "OverlayRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OverlayRoom"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "monaworld-media" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "monaworld",
    "database_id": "b6adc942-87de-4331-b747-6e6483b72f12",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "APP_ORIGIN": "https://monaworld.lamonachinajuega.workers.dev",
    "SUPPORT_PAYPAL_EMAIL": "lamonachinajuega@gmail.com"
  }
}
