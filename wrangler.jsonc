{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"vtuber-unified",
  "main":"src/index.ts",
  "compatibility_date":"2026-08-22",
  "assets":{"directory":"./public","binding":"ASSETS"},
  "durable_objects":{"bindings":[{"name":"OVERLAY_ROOM","class_name":"OverlayRoom"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["OverlayRoom"]}],
  "d1_databases":[{"binding":"DB","database_name":"vtuber-unified","database_id":"REPLACE_WITH_YOUR_D1_DATABASE_ID"}],
  "vars":{"APP_ORIGIN":"http://localhost:8787","UC_PER_UNIT":"100"}
}
